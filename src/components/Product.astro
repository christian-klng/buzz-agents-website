---
import type { Content } from "../i18n/de";
type Props = { data: Content["product"] };
const { data } = Astro.props;
---

<section id="produkt" class="section">
  <div class="product__head">
    <p class="eyebrow">{data.eyebrow}</p>
    <h2 class="h2">{data.headline}</h2>
  </div>
  <div class="product__rows">
    {
      data.rows.map((row) => (
        <div class={`product__row${row.imageFirst ? "" : " product__row--reverse"}`}>
          <div class="product__shot">{row.placeholder}</div>
          <div>
            <p class="product__label">{row.label}</p>
            <h3 class="product__title">{row.title}</h3>
            <p class="product__body">{row.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
