---
import type { Content } from "../i18n/de";
type Props = { items: Content["features"] };
const { items } = Astro.props;
---

<section id="funktionen" style="scroll-margin-top:90px">
  <div class="features-grid">
    {
      items.map((f) => (
        <article class="feature">
          <div class="feature__num">
            <span class="num">{f.num}</span>
            <span class="arrow">→</span>
          </div>
          <h3 class="feature__title">{f.title}</h3>
          <p class="feature__body">{f.body}</p>
        </article>
      ))
    }
  </div>
</section>
