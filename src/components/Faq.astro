---
import type { Content } from "../i18n/de";
type Props = { data: Content["faq"] };
const { data } = Astro.props;
---

<section id="faq" class="section faq">
  <div>
    <p class="eyebrow">{data.eyebrow}</p>
    <h2 class="h2">{data.headline}</h2>
  </div>
  <div class="faq__list">
    {
      /* Native exklusives Akkordeon via shared name; erstes Item initial offen. */
      data.items.map((item, i) => (
        <details class="faq__item" name="faq" open={i === 0}>
          <summary class="faq__summary">
            <span class="faq__q">{item.q}</span>
            <span class="faq__icon" aria-hidden="true" />
          </summary>
          <p class="faq__answer">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
